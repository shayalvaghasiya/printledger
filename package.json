{
  "name": "printledger",
  "version": "1.0.0",
  "description": "PrintLedger — 3D Print Cost & Production Studio. Offline-first cost calculator for 3D printing makers, studios, and small sellers.",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "PrintLedger",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop": "npm run build && electron .",
    "dev:electron": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "cap:sync": "cap sync",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "idb-keyval": "^6.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^32.2.6",
    "jsdom": "^24.1.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^1.6.0",
    "wait-on": "^8.0.1"
  }
}